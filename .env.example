# Copy to .env and fill in. The agent works with whatever subset you provide;
# missing keys make the matching tool report a gap instead of fabricating.

# Model provider (deepagents defaults to Claude). One of these is required.
ANTHROPIC_API_KEY=

# Optional: override the model, passed to LangChain init_chat_model.
# e.g. anthropic:claude-sonnet-4-5
RESEARCH_AGENT_MODEL=

# --- Live integrations ---
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar
APOLLO_API_KEY=

# --- Premium data sources (stubbed until you wire them in tools.py) ---
PITCHBOOK_API_KEY=
FACTSET_API_KEY=
HARMONIC_API_KEY=
CLAY_API_KEY=
