# Copy to .env and fill in. The agent works with whatever subset you provide;
# missing keys make the matching tool report a gap instead of fabricating.

# --- Model (vendor-neutral) ---
# The agent runs on any LangChain-supported provider. Set RESEARCH_AGENT_MODEL
# to a "provider:model" id and supply that provider's key. Defaults to
# anthropic:claude-sonnet-4-5.
RESEARCH_AGENT_MODEL=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Live data integrations ---
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar
APOLLO_API_KEY=

# --- Premium data sources (stubbed until you wire them in tools.py) ---
PITCHBOOK_API_KEY=
FACTSET_API_KEY=
HARMONIC_API_KEY=
CLAY_API_KEY=

# --- Multi-tenancy (optional) ---
# Path to a JSON registry of tenants (see docs/multi-tenancy.md). Per-tenant
# vars TENANT_<ID>_<KEY> are also supported.
# TENANTS_CONFIG=/etc/research-agent/tenants.json

# --- Feature flags via OpenFeature (optional) ---
# OF_RESEARCH_ENABLE_CRITIQUE=true
# OF_RESEARCH_ENABLED_PACKS=investor,people,market

# --- MCP server (optional) ---
# MCP_TRANSPORT=stdio   # or streamable-http
